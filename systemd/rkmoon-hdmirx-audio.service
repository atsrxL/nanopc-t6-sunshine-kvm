[Unit]
Description=RKMoon HDMI-RX audio capture codec rebind
After=systemd-modules-load.service sound.target
Before=rkmoon-input.service rkmoon.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /opt/rkmoon/current/tools/hdmirx_audio_bind.py

[Install]
WantedBy=multi-user.target
