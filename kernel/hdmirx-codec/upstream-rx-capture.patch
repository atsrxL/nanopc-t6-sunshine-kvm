--- a/sound/soc/codecs/hdmi-codec.c
+++ b/sound/soc/codecs/hdmi-codec.c
@@ -5,6 +5,7 @@
  * Author: Jyri Sarha <jsarha@ti.com>
  */
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/string.h>
 #include <sound/core.h>
 #include <sound/jack.h>
@@ -1067,6 +1068,16 @@
 	.set_jack		= hdmi_codec_set_jack,
 };
 
+/* HDMI RX shares this codec with TX. Never infer direction from I2S alone. */
+static bool hdmi_codec_is_hdmirx(struct device *dev)
+{
+	return dev->parent &&
+		(of_device_is_compatible(dev->parent->of_node,
+					 "rockchip,rk3588-hdmirx-ctrler") ||
+		 of_device_is_compatible(dev->parent->of_node,
+					 "rockchip,hdmirx-ctrler"));
+}
+
 static int hdmi_codec_probe(struct platform_device *pdev)
 {
 	struct hdmi_codec_pdata *hcd = pdev->dev.platform_data;
@@ -1075,6 +1086,7 @@
 	struct hdmi_codec_priv *hcp;
 	int dai_count, i = 0;
 	int ret;
+	bool is_hdmirx = hdmi_codec_is_hdmirx(dev);
 
 	if (!hcd) {
 		dev_err(dev, "%s: No platform data\n", __func__);
@@ -1115,16 +1127,20 @@
 		 * causes "Only one simultaneous stream supported!" errors
 		 * and results in mono audio output.
 		 */
-		daidrv[i].capture.channels_min = 0;
-		daidrv[i].capture.channels_max = 0;
+		if (!is_hdmirx) {
+			daidrv[i].capture.channels_min = 0;
+			daidrv[i].capture.channels_max = 0;
+		}
 		i++;
 	}
 
 	if (hcd->spdif) {
 		daidrv[i] = hdmi_spdif_dai;
 		/* Disable capture for HDMI-TX SPDIF (output only) */
-		daidrv[i].capture.channels_min = 0;
-		daidrv[i].capture.channels_max = 0;
+		if (!is_hdmirx) {
+			daidrv[i].capture.channels_min = 0;
+			daidrv[i].capture.channels_max = 0;
+		}
 	}
 
 	dev_set_drvdata(dev, hcp);
